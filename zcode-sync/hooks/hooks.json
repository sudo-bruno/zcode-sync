{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PLUGIN_ROOT}/scripts/auto_sync.py\" start",
            "timeout": 10,
            "statusMessage": "zcode-sync: sincronizando em segundo plano"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PLUGIN_ROOT}/scripts/auto_sync.py\" stop",
            "timeout": 10,
            "statusMessage": "zcode-sync: push em segundo plano"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PLUGIN_ROOT}/scripts/prompt_hook.py\"",
            "timeoutMs": 600000,
            "statusMessage": "zcode-sync: executando comando"
          }
        ]
      }
    ]
  }
}